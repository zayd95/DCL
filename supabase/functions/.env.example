# Secrets des Edge Functions — à définir avec :
#   supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement)
GEMINI_API_KEY=
# Optionnel : modèle Gemini (défaut gemini-2.5-flash, gratuit dans les limites de Google AI Studio)
GEMINI_MODEL=
# Optionnel : bot Telegram pour le briefing du matin (créé via @BotFather, gratuit)
TELEGRAM_BOT_TOKEN=
